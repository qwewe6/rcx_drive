# Copy to .env.local and fill in once a Supabase project is provisioned.
# Both are the public URL / anon (publishable) key — safe to expose in a
# client bundle, per Supabase's own guidance; RLS policies (see
# supabase/migrations/) are what actually protect data, not this key.
#
# Leave unset to keep running on local/mock auth
# (src/services/auth/mockAuthService.ts) — see docs/plans/user-data-model.md.

EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
